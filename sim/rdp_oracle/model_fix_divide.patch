+    int32_t v = (shift != 14 ? prod >> (13 - shift) : prod * 2) & 0x1FFFF;
+    return (v & 0x10000) ? v - 0x20000 : v;
+}
+/* S / W for the pixel's texel: the 17 bits saturated to 16 (out of range: the end it went past) */
+static int32_t n64_persp(int32_t s, int32_t w)
+{
+    int range;
+    const int32_t v = n64_div(s, w, &range);
+    if (range) return range == 2 ? 32767 : -32768;
